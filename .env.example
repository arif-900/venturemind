# VentureMind Environment Configuration Template
# Copy this file to .env and replace with your actual keys

# Client-accessible keys (Must use VITE_ or NEXT_PUBLIC_)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# Mapbox Public Token (for interactive territory maps)
VITE_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VyIiwiYSI6InlvdXItdG9rZW4ifQ.your-mapbox-token
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VyIiwiYSI6InlvdXItdG9rZW4ifQ.your-mapbox-token

# Server-only keys (NEVER expose to client bundles with VITE_ or NEXT_PUBLIC_ prefixes)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
GEMINI_API_KEY=your-gemini-api-key-placeholder
